# Copy to .env for local development: `cp .env.example .env`
# Every variable read by backend/config/settings is documented here.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,backend
# Tenants are resolved from <slug>.<TENANT_BASE_DOMAIN> (E02 adds custom domains + header resolution)
TENANT_BASE_DOMAIN=localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://*.localhost:5173,http://*.localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (host port 5442 avoids clashing with a local Postgres on 5432) ---
# Three roles (FR-02-4). `manage.py ensure_db_roles` creates the app and platform roles.
# App role: not the table owner and NOBYPASSRLS, so row-level security applies to it.
DATABASE_URL=postgres://tutortrack_app:tutortrack_app@localhost:5442/tutortrack
# Owner/migration role: `manage.py migrate` uses it automatically.
DATABASE_OWNER_URL=postgres://tutortrack:tutortrack@localhost:5442/tutortrack
# BYPASSRLS role for platform-admin code only (E30).
DATABASE_PLATFORM_URL=postgres://tutortrack_platform:tutortrack_platform@localhost:5442/tutortrack

# --- Redis (cache, Celery broker, locks) ---
REDIS_URL=redis://localhost:6389/0
CELERY_BROKER_URL=redis://localhost:6389/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (MinIO locally, S3 in prod) ---
AWS_STORAGE_BUCKET_NAME=tutortrack-local
AWS_S3_ENDPOINT_URL=http://localhost:9010
# Endpoint used when presigning URLs handed to browsers (differs from the in-container endpoint)
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9010
AWS_ACCESS_KEY_ID=tutortrack
AWS_SECRET_ACCESS_KEY=tutortrack-secret
AWS_S3_REGION_NAME=eu-west-2

# --- Antivirus (ClamAV clamd) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# When false, uploads are marked clean without scanning (local dev without the clamav profile)
CLAMAV_ENABLED=false

# --- Temporal (E32): `make infra` starts a dev server; production uses Temporal Cloud ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=tutortrack-local
# Temporal Cloud: either mTLS (cert/key file paths) or an API key
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=
TEMPORAL_API_KEY=
# AES-256-GCM keys for workflow payloads (base64, 32 bytes), newest first; dev default used if unset
# TEMPORAL_PAYLOAD_KEYS=

# --- Email (Mailpit captures everything locally: http://localhost:8025) ---
EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=TutorTrack <noreply@tutortrack.localhost>

# --- Observability (optional locally) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=false

# --- Signup (Cloudflare Turnstile captcha; leave empty locally to skip verification) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Root app URL used in emails (signup, email verification)
APP_URL=http://localhost:5173

# --- Sign in with Google / Microsoft (optional; redirect URI: $APP_URL/api/v1/auth/sso/<provider>/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Fernet keys for encrypted fields (MFA secrets), newest first. Required in production.
# FIELD_ENCRYPTION_KEYS=<newest key>,<older key>

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8010
VITE_SENTRY_DSN=

# Payments (E11): Stripe Connect platform keys. Leave empty to use the built-in fake
# provider (development and tests). Webhooks: stripe listen --forward-connect-to
# localhost:8010/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APPLICATION_FEE_PERCENT=0
# E11 Phase 2: GoCardless partner app and PayPal partner credentials. Empty = fake providers.
# Webhooks: /webhooks/gocardless and /webhooks/paypal.
GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_APP_FEE_PERCENT=0
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Our own subscription (E04): webhook secret for /webhooks/stripe/platform
STRIPE_BILLING_WEBHOOK_SECRET=
SUBSCRIPTION_TRIAL_DAYS=30
# Leads (E17): Postmark inbound webhook token (/webhooks/inbound-email?token=)
INBOUND_EMAIL_TOKEN=

# Communications (E13). Empty Twilio settings = texts are recorded, not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
POSTMARK_WEBHOOK_TOKEN=
# Web Push (E16): `cd backend && uv run python manage.py generate_vapid_keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tutortrack.app
PLATFORM_BASE_URL=http://localhost:8010

# --- Calendar and video integrations (E22). Empty keys = in-memory fakes. ---
# Google/Microsoft default to the SSO apps above; add the calendar/meeting scopes to them.
INTEGRATIONS_GOOGLE_CLIENT_ID=
INTEGRATIONS_GOOGLE_CLIENT_SECRET=
INTEGRATIONS_MICROSOFT_CLIENT_ID=
INTEGRATIONS_MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom app's webhook secret token: attendance and recordings at $API_URL/webhooks/zoom (E22-T10)
ZOOM_WEBHOOK_SECRET=
DAILY_API_KEY=
WHEREBY_API_KEY=
# Built-in rooms needing no tutor account: daily or whereby
INTEGRATIONS_BUILTIN_ROOMS=daily
# CalDAV (iCloud) and Lessonspace use tenant-entered credentials; false = fakes (local default)
INTEGRATIONS_CREDENTIAL_PROVIDERS_LIVE=false
# Public URL Google/Microsoft push notifications reach (defaults to PLATFORM_BASE_URL)
INTEGRATIONS_WEBHOOK_BASE_URL=

# --- Accounting integrations (E23). Empty keys = the in-memory fake ledger. ---
# Redirect URI for both: $APP_URL/api/v1/integrations/oauth/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_SANDBOX=false
# Phase 3 ledgers (E23-T10); Xero Payroll uses the Xero app above with payroll scopes
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_SANDBOX=false

# --- Phase 3 integrations (ADR 0032) ---
# Wise payouts (E12-T12): organisations connect their own token; this is Wise's webhook key
WISE_API_URL=https://api.wise.com
WISE_WEBHOOK_PUBLIC_KEY=
# Background checks (E18-T11): API hosts; organisations connect their own uCheck/Checkr keys
CHECKR_API_URL=https://api.checkr.com/v1
UCHECK_API_URL=https://api.ucheck.co.uk/v1
DBS_UPDATE_SERVICE_URL=https://secure.crbonline.gov.uk/crsc/api/status
# Warehouse export (E26-T09): false = S3/BigQuery/Snowflake destinations use a fake (local default)
WAREHOUSE_EXPORT_LIVE=false
WAREHOUSE_EXPORT_MAX_ROWS=200000
# --- Websites, widgets and custom domains (E24) ---
# Hosted websites live at <slug>.<SITE_BASE_DOMAIN> (dev default: site.localhost)
SITE_BASE_DOMAIN=site.localhost
# Tenants CNAME their custom domains to this host
CUSTOM_DOMAINS_CNAME_TARGET=custom.tutortrack.app
# "fake" (dev/tests) or "doh" (DNS over HTTPS); production defaults to doh
CUSTOM_DOMAINS_DNS_RESOLVER=fake
CUSTOM_DOMAINS_DOH_URL=https://cloudflare-dns.com/dns-query
# The fake resolver accepts every domain locally
CUSTOM_DOMAINS_FAKE_AUTO_VERIFY=true
# TLS: cloudflare (Cloudflare for SaaS), caddy (on-demand TLS asking /internal/tls/ask) or fake.
# Empty: cloudflare when CLOUDFLARE_API_TOKEN is set, else fake.
CUSTOM_DOMAINS_CERT_PROVIDER=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Refuse hosts that are neither platform hosts nor connected domains (use with DJANGO_ALLOWED_HOSTS=*)
CUSTOM_DOMAINS_STRICT_HOSTS=false
CUSTOM_DOMAINS_PLATFORM_HOSTS=
# Where embed codes load the widget script from (dev: the widgets Vite server)
WIDGETS_SCRIPT_URL=http://localhost:5175/src/index.ts
THROTTLE_PUBLIC_WIDGET=600/hour
# --- AI assistant (E31, ADR 0029). Empty ANTHROPIC_API_KEY = a deterministic fake (no network). ---
ANTHROPIC_API_KEY=
# anthropic | fake (empty: anthropic when a key is set)
AI_PROVIDER=
AI_MODEL_DEFAULT=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Server-side refusal fallbacks on Opus requests (Claude API only)
AI_REFUSAL_FALLBACKS=true
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_USER_REQUESTS_PER_MINUTE=20
# Dotted path of a speech-to-text Transcriber for voice notes (none ships yet)
AI_TRANSCRIBER=
