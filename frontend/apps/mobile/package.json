{
  "name": "@tutortrack/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Capacitor native shells for the TutorTrack portal (E16-T11). Not part of the pnpm workspace: install it on its own (see .github/workflows/mobile-build.yml).",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "test": "node --test scripts/configure.test.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor \"$(node scripts/configure.mjs --print primaryColour)\"",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "7.4.2",
    "@capacitor/app": "7.0.2",
    "@capacitor/core": "7.4.2",
    "@capacitor/ios": "7.4.2",
    "@capacitor/splash-screen": "7.0.2",
    "@capacitor/status-bar": "7.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
